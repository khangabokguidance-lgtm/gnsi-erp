{
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/window-notifier",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/hostel-compliance-enforce",
      "schedule": "0 18 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}